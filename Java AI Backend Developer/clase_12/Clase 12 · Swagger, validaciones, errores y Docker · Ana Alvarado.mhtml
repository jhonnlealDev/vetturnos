  .mindmap-node::before { display: none; }
  .shape-board { grid-template-columns: 1fr 1fr; }
  .er-board { grid-template-columns: 1fr; }
  .emoji-hero { font-size: clamp(3rem, 20vw, 5rem); }
  .hero { padding-top: 84px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.01ms !important; transition-=
duration: 0.01ms !important; scroll-behavior: auto !important; }
}

@media print {
  .controls, .topline, .watermark, .copy-btn, .sb-toggle { display: none !i=
mportant; }
  body { background: rgb(255, 255, 255); color: rgb(0, 0, 0); }
  .shell { display: block; }
  .sidebar { display: none; }
  .hero, .content { padding-left: 0px; padding-right: 0px; }
  .reveal[open] > summary { display: none; }
  .reveal, .reveal-body { border: 0px; padding: 0px; }
}
